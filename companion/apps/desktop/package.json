{
  "name": "@companion/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop shell for the companion",
  "author": "Owner",
  "license": "UNLICENSED",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node esbuild.mjs && vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@companion/core": "0.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.kkc36.companion",
    "productName": "Companion",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
