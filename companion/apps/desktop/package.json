{
  "name": "@companion/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop shell for the companion",
  "author": "Owner",
  "license": "UNLICENSED",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run build:voice && node esbuild.mjs && vite build",
    "build:voice": "node scripts/build-voice.mjs",
    "start": "electron .",
    "package": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@github/keytar": "7.10.6",
    "better-sqlite3-multiple-ciphers": "13.0.3"
  },
  "devDependencies": {
    "@companion/core": "0.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.kkc36.companion",
    "productName": "Companion",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "resources/voice",
        "to": "voice",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.bin/**",
      "!node_modules/node-addon-api/**",
      "!node_modules/better-sqlite3-multiple-ciphers/deps/**",
      "!node_modules/better-sqlite3-multiple-ciphers/src/**",
      "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/*",
      "node_modules/better-sqlite3-multiple-ciphers/prebuilds/win32-x64.node",
      "!node_modules/@github/keytar/src/**",
      "!node_modules/@github/keytar/script/**",
      "!node_modules/@github/keytar/build/**",
      "!node_modules/@github/keytar/prebuilds/**",
      "node_modules/@github/keytar/prebuilds/win32-x64/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
