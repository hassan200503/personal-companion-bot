{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "edit": "allow",
    "external_directory": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git branch*": "allow",
      "npm run *": "allow",
      "npm test*": "allow",
      "npm ci*": "allow",
      "npm install*": "allow",
      "pnpm run *": "allow",
      "pnpm test*": "allow",
      "pnpm install*": "allow",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "todowrite": "allow",
    "skill": "allow"
  }
}
